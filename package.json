{
  "name": "n8n-nodes-autotask",
  "version": "2.29.3",
  "description": "n8n node for Autotask PSA integration",
  "keywords": [
    "n8n-community-node-package",
    "autotask",
    "psa",
    "datto",
    "n8n"
  ],
  "license": "MIT",
  "homepage": "https://github.com/msoukhomlinov/n8n-nodes-autotask",
  "author": {
    "name": "Max Soukhomlinov",
    "email": "maxs@intellectit.com.au"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/msoukhomlinov/n8n-nodes-autotask.git"
  },
  "engines": {
    "node": ">=18.19",
    "pnpm": ">=9.1"
  },
  "packageManager": "pnpm@11.18.0",
  "main": "dist/nodes/Autotask/Autotask.node.js",
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "n8n-node lint",
    "lintfix": "n8n-node lint --fix",
    "lint:fix": "n8n-node lint --fix",
    "typecheck": "tsc --noEmit",
    "release": "n8n-node release",
    "prepublishOnly": "pnpm lint && pnpm typecheck && pnpm build"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": false,
    "credentials": [
      "dist/credentials/AutotaskApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Autotask/Autotask.node.js",
      "dist/nodes/Autotask/AutotaskTrigger.node.js",
      "dist/nodes/Autotask/AutotaskAiTools.node.js",
      "dist/nodes/Autotask/AutotaskMcpTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@langchain/classic": "^1.0.29",
    "@langchain/core": "^1.1.39",
    "@modelcontextprotocol/sdk": "~1.26.0",
    "@n8n/node-cli": ">=0.29.0",
    "@types/node": "^22.15.0",
    "@types/pluralize": "^0.0.33",
    "eslint": "9.32.0",
    "n8n-workflow": "^2.20.0",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "zod": "^3.23.0"
  },
  "dependencies": {
    "keyv": "^5.6.0",
    "keyv-file": "^5.3.3",
    "moment-timezone": "^0.5.48",
    "pluralize": "^8.0.0",
    "redis": "^5"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "peerDependenciesMeta": {
    "n8n-workflow": {
      "optional": true
    }
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server": ">=2.0.5",
      "axios@<1.16.0": ">=1.18.0",
      "brace-expansion@1": ">=1.1.16",
      "fast-uri@3": ">=3.1.4",
      "form-data@4": ">=4.0.6",
      "hono": ">=4.12.27",
      "js-yaml@4": ">=4.3.0",
      "langsmith@<0.6.0": "^0.6.3",
      "tmp@<0.2.6": ">=0.2.6",
      "undici": ">=6.27.0",
      "uuid": ">=11.1.1",
      "uuid@>=13.0.0 <13.0.1": ">=13.0.1",
      "ws@8": ">=8.21.0"
    }
  }
}
